# SamaPos — variables de entorno
# Copia este archivo a `.env` y completa los valores.

# ───────── Database ─────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=restaurant_pos

# ───────── Server ─────────
PORT=3000
NODE_ENV=production

# ───────── Licencias (CRÍTICO) ─────────
# Secreto HMAC para firmar los license tokens.
# Genera uno nuevo con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Si no lo defines, el server usa un default visible (SOLO desarrollo).
LICENSE_HMAC_SECRET=

# ───────── Bootstrap (solo primera vez) ─────────
# Serial de la primera terminal a aprobar. Lo encuentras en
# C:\ProgramData\SamaPos\terminal.serial de la máquina admin.
LICENSE_BOOTSTRAP_SERIAL=

# Tier inicial: 'trial' o 'standard'. Default: 'standard'.
LICENSE_BOOTSTRAP_TIER=standard

# Etiqueta opcional para la terminal bootstrap.
LICENSE_BOOTSTRAP_LABEL=

# ───────── Dev / creador (opcional) ─────────
# Tu(s) máquina(s) SIEMPRE autorizada(s): no necesitan aprobación ni
# dependen del estado de la licencia (pending/revoked/vencida).
# Copiá el serial desde la pantalla de bloqueo del POS (botón "Copiar")
# o desde DevTools → localStorage → 'v1.terminal.serial'. Separalos con
# coma si son varias máquinas.
#LICENSE_DEV_SERIALS=8f3a2b1c-4d5e-6f7a-8b9c-0d1e2f3a4b5c,427ab413-13de-4c7c-a8c0-c6a4b8f55f24
# Alternativa radical (SOLO desarrollo local): autoriza CUALQUIER terminal.
# NO la uses en un server compartido o de producción.
#LICENSE_DEV_MODE=true
