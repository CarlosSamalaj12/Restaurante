{
  "name": "restautante-pos",
  "version": "1.0.0",
  "description": "POS de restaurante con Node.js + HTML/CSS/JS",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev:all": "concurrently \"node server.js\" \"cd react-app && npm run dev\"",
    "dev:server": "node server.js",
    "dev:client": "cd react-app && npm run dev",
    "license:bootstrap": "node bin/bootstrap-license.js",
    "test:unit": "node tests/unit/run.js",
    "test:smoke": "node scripts/smoke.js",
    "test:smoke:auth": "node scripts/smoke.js --pin 1234",
    "test:smoke:ci": "node scripts/smoke.js --ci",
    "test:e2e": "cd tests/e2e && npm test",
    "test:e2e:install": "cd tests/e2e && npm install && npx playwright install --with-deps chromium",
    "test:e2e:headed": "cd tests/e2e && npm run test:headed",
    "test:e2e:ui": "cd tests/e2e && npm run test:ui",
    "test:e2e:report": "cd tests/e2e && npm run test:report",
    "test": "npm run test:unit && npm run test:smoke",
    "test:all": "npm run test:unit && npm run test:smoke && npm run test:e2e"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "dotenv": "^17.3.1",
    "escpos": "^3.0.0-alpha.6",
    "escpos-network": "^3.0.0-alpha.5",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "mysql2": "^3.18.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}
